<UserControl x:Class="DQB2TextEditor.Windows.UserControlFolder.DialoguePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DQB2TextEditor.Windows.UserControlFolder"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:HighlightWordConverter x:Key="HighlightConverter"
                                  WordToHighlight="key"
                                  HighlightColor="Orange"/>
    </UserControl.Resources>
    <Viewbox>
        <Border IsHitTestVisible="False" BorderBrush="White" Background="Black" BorderThickness="1" CornerRadius="4">
            <TextBlock
            local:TextBlockExtensions.HighlightedText="{Binding .}"
            Padding="12,7"
               Width="286" 
               MinHeight="{Binding DataContext.DialogueHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
               LineHeight="13" LineStackingStrategy="BlockLineHeight"
               FontSize="{Binding DataContext.PreviewFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
               FontFamily="{Binding DataContext.PreviewFontFamily, RelativeSource={RelativeSource AncestorType=ListBox}}"
               TextWrapping="WrapWithOverflow">
            </TextBlock>
        </Border>
    </Viewbox>
</UserControl>
