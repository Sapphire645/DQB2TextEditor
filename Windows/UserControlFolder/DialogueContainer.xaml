<UserControl x:Class="DQB2TextEditor.Windows.UserControlFolder.DialogueContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DQB2TextEditor.Windows.UserControlFolder"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="RunCheck">
    <UserControl.Resources>
        <local:HighlightWordConverter x:Key="HighlightConverter"
                                  WordToHighlight="key"
                                  HighlightColor="Orange"/>
    </UserControl.Resources>
    <Viewbox>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286"/>
                <ColumnDefinition Width="286"/>
            </Grid.ColumnDefinitions>
            <Border MinHeight="20" Background="{StaticResource DarkBlueBrush}" BorderBrush="Black" Panel.ZIndex="1" BorderThickness="1" Padding="2.5" HorizontalAlignment="Left" CornerRadius="4" Margin="0,0,0,-1.5">
                    <TextBlock Foreground="White" Text="{Binding CommandName, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="8" VerticalAlignment="Center" Margin="1,0,5,0">

                    </TextBlock>
                </Border>
                <Border Grid.Row="1" Background="{StaticResource DarkBlueBrush}" BorderBrush="Black" BorderThickness="1" Padding="5,0" CornerRadius="4" 
                        >
                    <ItemsControl
                        ItemsSource="{Binding Arguments, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Foreground="White" FontSize="8" Text="{Binding .}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            <Border Grid.Column="1"  Visibility="{Binding NameVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,0,-1.5" Panel.ZIndex="1" Name="TextBoxName" IsHitTestVisible="False" BorderBrush="White" Background="Black" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Left">
                    <TextBlock 
    local:TextBlockExtensions.HighlightedText="{Binding CharName,RelativeSource={RelativeSource AncestorType=UserControl}}"
    Padding="10, 4, 10, 1"
   FontSize="12"
   FontFamily="{Binding DataContext.PreviewFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                        Name="TBName">
                    </TextBlock>
                </Border>
            <Border Grid.Column="1" Grid.Row="1" Visibility="{Binding LineVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Name="TextBoxBG" IsHitTestVisible="False" BorderBrush="White" Background="Black" BorderThickness="1" Panel.ZIndex="0" CornerRadius="4">
                    <TextBlock 
                        Name="TextBoxLine"
local:TextBlockExtensions.HighlightedText="{Binding Line, RelativeSource={RelativeSource AncestorType=UserControl}}"
Padding="{Binding DataContext.PreviewPadding, RelativeSource={RelativeSource AncestorType=Window}}"
   Width="286"
   MinHeight="63"
   LineHeight="{Binding DataContext.PreviewLineSpace, RelativeSource={RelativeSource AncestorType=Window}}"
    LineStackingStrategy="BlockLineHeight"
   FontSize="{Binding DataContext.PreviewFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
   FontFamily="{Binding DataContext.PreviewFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
   TextWrapping="WrapWithOverflow">
                    </TextBlock>
                </Border>
        </Grid>
    </Viewbox>
</UserControl>

