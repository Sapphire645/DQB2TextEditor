<UserControl x:Class="DQB2TextEditor.Windows.UserControlFolder.DialogueContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DQB2TextEditor.Windows.UserControlFolder"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="RunCheck">
    <Viewbox>
        <StackPanel Orientation="Horizontal">
            <StackPanel Orientation="Vertical">
                <Border Visibility="{Binding NameVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,0,-1.5" Panel.ZIndex="1" Name="TextBoxName" IsHitTestVisible="False" BorderBrush="White" Background="Black" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Left">
                    <TextBlock
    local:TextBlockExtensions.HighlightedText="{Binding CharName,RelativeSource={RelativeSource AncestorType=UserControl}}"
    Padding="10, 4, 10, 1"
       FontSize="12"
       FontFamily="{Binding DataContext.PreviewFontFamily, RelativeSource={RelativeSource AncestorType=Window}}">
                    </TextBlock>
                </Border>
                <Border Visibility="{Binding LineVisible, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Name="TextBoxBG" IsHitTestVisible="False" BorderBrush="White" Background="Black" BorderThickness="1" Panel.ZIndex="0" CornerRadius="4">
                    <TextBlock
    local:TextBlockExtensions.HighlightedText="{Binding FlowDataEntry.Line, RelativeSource={RelativeSource AncestorType=UserControl}}"
    Padding="{Binding DataContext.PreviewPadding, RelativeSource={RelativeSource AncestorType=Window}}"
       Width="286"
       MinHeight="{Binding DataContext.DialogueHeight, RelativeSource={RelativeSource AncestorType=Window}}"
       LineHeight="{Binding DataContext.PreviewLineSpace, RelativeSource={RelativeSource AncestorType=Window}}"
        LineStackingStrategy="BlockLineHeight"
       FontSize="{Binding DataContext.PreviewFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
       FontFamily="{Binding DataContext.PreviewFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
       TextWrapping="WrapWithOverflow">
                    </TextBlock>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <Border Background="{StaticResource DarkBlueBrush}" BorderBrush="Black" BorderThickness="1" Padding="3" CornerRadius="4" Margin="0,1,0,0">
                <TextBlock Text="{Binding CommandName, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="10"/>
            </Border>
                <Border Background="{StaticResource DarkBlueBrush}" BorderBrush="Black" BorderThickness="1" Padding="5" CornerRadius="4" MinWidth="286">
                    <ItemsControl ItemsSource="{Binding Arguments, RelativeSource={RelativeSource AncestorType=UserControl}}" >
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock FontSize="9" Text="{Binding .}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </StackPanel>
    </Viewbox>
</UserControl>

