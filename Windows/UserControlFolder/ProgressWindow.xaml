<Window x:Class="DQB2TextEditor.Windows.UserControlFolder.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DQB2TextEditor.Windows.UserControlFolder"
        mc:Ignorable="d"
       Title="Loading..."
        Height="200" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False" Background="Black">
    <Border BorderBrush="{StaticResource DarkBlueBrush}" Margin="20" BorderThickness="2">
        <StackPanel Margin="10" >
            <TextBlock Name="tname" Text="Please wait..." Margin="10" HorizontalAlignment="Center"/>
            <ProgressBar Name="Bar" Height="20"/>
            <TextBlock Name="progress" Text="Please wait..." Margin="10" HorizontalAlignment="Center"/>
            <TextBlock Name="searching" Text="Please wait..." Margin="10" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
