<Window x:Class="DQB2TextEditor.Windows.SelectLinkdata"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DQB2TextEditor.Windows"
        mc:Ignorable="d"
        Title="DQB2 Text Editor V2 : Select Linkdata" Height="450" Width="800" Background="Black">
    <Border BorderBrush="{StaticResource DarkBlueBrush}" Margin="20" BorderThickness="2">
    <StackPanel VerticalAlignment="Center" Margin="20" >
       
        <TextBlock FontSize="14" Margin="2" Text="LINKDATA Path" HorizontalAlignment="Center"/>
        <Grid VerticalAlignment="Center" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="TextBox" Text="{Binding LinkdataPath}" Foreground="{Binding LinkdataError}"/>
            <Button Grid.Column="1" Content="..." Width="50" Click="LinkdataPathUpdate"/>
        </Grid>
        <Grid HorizontalAlignment="Center" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Size:" MinWidth="160"/>
            <TextBlock Text="{Binding Size}" TextAlignment="Right" Grid.Column="1" Foreground="{Binding VersionErrorSize}"/>
            <TextBlock Text="Version detected:" MinWidth="160" HorizontalAlignment="Right" Grid.Row="1"/>
            <TextBlock Text="{Binding VersionName}" TextAlignment="Right" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="1"  Foreground="{Binding VersionError}"/>
            <TextBlock Text="LINKDATA_PATCH.IDX Found" HorizontalAlignment="Center" Grid.Row="2" Grid.ColumnSpan="2" Visibility="{Binding foundPatchV}" Foreground="LimeGreen"/>
            </Grid>

        <Button Content="Confirm" Margin="6" IsEnabled="{Binding ConfirmEnabled}" Click="Confirm_Click"/>
    </StackPanel>
    </Border>
</Window>
