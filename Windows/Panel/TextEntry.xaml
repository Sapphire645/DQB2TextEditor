<UserControl x:Class="DQB2TextEditor.Windows.Panel.TextEntry"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DQB2TextEditor.Windows.Panel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      xmlns:UC="clr-namespace:DQB2TextEditor.Windows.UserControlFolder">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Name="BorderPreview" Grid.Row="1" BorderBrush="{StaticResource DarkBlueBrush}" BorderThickness="2" Margin="2">
            <DockPanel>
                <Grid DockPanel.Dock="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Rectangle Fill="{StaticResource DarkBlueBrush}" Grid.ColumnSpan="3" Height="2"/>
                    <TextBlock Margin="5,2" Text="Filter:" VerticalAlignment="Center" Grid.Column="0" Grid.Row="1"/>
                    <TextBox Margin="1" BorderThickness="0" Text="{Binding FilterText,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Center" Grid.Column="1" Grid.Row="1" TextWrapping="WrapWithOverflow"/>
                    <Button Click="Search_Click" Margin="5,2" Content="Search" HorizontalAlignment="Right" Grid.Column="2" Grid.Row="1" Padding="5,0" VerticalContentAlignment="Center" ToolTipService.InitialShowDelay="0" >
                        <Button.ToolTip>
                            <ToolTip Background="Black">
                                <Label Content="WARNING: This will take a long time."/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </Grid>
                <ListBox Name="LinesList" Background="Black" BorderThickness="0"
                 ItemsSource="{Binding DataContext.TextLinesEdit, RelativeSource={RelativeSource AncestorType=Window}}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="Line_SelectionChanged"
                         MouseMove="ListBox_MouseMove">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <UC:TextContainer DisplayText="{Binding .}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
            </DockPanel>
        </Border>
        <GridSplitter Grid.Column="1"
              Width="6"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="{StaticResource DarkBlueBrush}"
              ShowsPreview="True"/>
        <Line Y1="0" X2="1" X1="1" Y2="20" StrokeDashArray="0.25 2" StrokeDashCap="Round" IsHitTestVisible="False" Stroke=" Gray" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
        <Grid Grid.Column="2" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox TextWrapping="WrapWithOverflow" Margin="1" Text="{Binding DataContext.EditingLine, RelativeSource={RelativeSource AncestorType=Window},UpdateSourceTrigger=PropertyChanged}"/>
            <UC:DialoguePreview Margin="1"  Grid.Row="1" x:Name="DPrev"  DisplayText="{Binding DataContext.EditingLine, RelativeSource={RelativeSource AncestorType=Window}}"/>

            
            <Grid Grid.Row="2" Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Save line" Click="SaveLine" Margin="4"/>
                <Button Grid.Column="1" Content="Copy line" Click="CopyLine" Margin="4"/>
            </Grid>
            
        </Grid>
    </Grid>
</UserControl>
