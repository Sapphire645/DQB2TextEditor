<Window x:Class="DQB2TextEditor.Windows.TextEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DQB2TextEditor.Windows"
        xmlns:UC="clr-namespace:DQB2TextEditor.Windows.UserControlFolder"
        xmlns:panel="clr-namespace:DQB2TextEditor.Windows.Panel"
        mc:Ignorable="d"
        Title="DQB2 Text Editor V2" Height="450" Width="960" Background="Black" MinWidth="960" MinHeight="200"
        >
    <DockPanel Margin="2">
        <Grid DockPanel.Dock="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource DarkBlueBrush}" Margin="2,1,2,2" CornerRadius="5">
            </Border>
            <Border Background="{StaticResource DarkBlueBrush}" Grid.Row="1" Margin="2,1,2,2" CornerRadius="5">
            </Border>
            <Grid Margin="0,7" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" HorizontalAlignment="Left" Margin="8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Visibility="{Binding selectedVisibility}" Text="{Binding Path=Selection, StringFormat=Selected {0}}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Visibility="{Binding selectedVisibility}" Text="{Binding SelectedTextGroup.Index}" Foreground="White" Grid.Row="1" HorizontalAlignment="Center"/>
                    <TextBlock Visibility="{Binding editingVisibility}" Text="{Binding Path=EditedSelection, StringFormat=Editing {0}}" Grid.Row="3" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Visibility="{Binding editingVisibility}" Text="{Binding EditingTextGroup.Index}" Foreground="White" Grid.Row="4" HorizontalAlignment="Center"/>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Width="2" Background="Black" CornerRadius="2"/>
                    <Border Width="2" Background="Black" Grid.Row="2" CornerRadius="2"/>
                </Grid>
                <Grid Grid.Column="2" HorizontalAlignment="Center" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Flow Data" FontWeight="Bold" Margin="8,0"  Foreground="{StaticResource FlowDataBold}"/>
                    <TextBlock Text="Offset" HorizontalAlignment="Center" Grid.Column="1" Margin="8,0" Foreground="{StaticResource FlowData}"/>
                    <TextBlock Text="Compressed Size" HorizontalAlignment="Center" Grid.Column="2" Margin="8,0" Foreground="{StaticResource FlowData}"/>
                    <TextBlock Text="Uncompressed Size" HorizontalAlignment="Center" Grid.Column="3" Margin="8,0" Foreground="{StaticResource FlowData}"/>
                    <TextBlock Text="{Binding SelectedTextGroup.FlowDataIndex}" Foreground="White" Grid.Row="1" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTextGroup.FlowDataOffset}" Foreground="White" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTextGroup.FlowDataCompressedSize}" Foreground="White" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTextGroup.FlowDataUncompressedSize}" Foreground="White" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center"/>

                    <TextBlock Text="Flow Data" FontWeight="Bold" Margin="8,0" Grid.Row="3" Foreground="{StaticResource FlowDataBold}"/>
                    <TextBlock Text="Offset" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="3" Margin="8,0" Foreground="{StaticResource FlowData}"/>
                    <TextBlock Text="Compressed Size" HorizontalAlignment="Center" Grid.Column="2" Grid.Row="3" Margin="8,0" Foreground="{StaticResource FlowData}"/>
                    <TextBlock Text="Uncompressed Size" HorizontalAlignment="Center" Grid.Column="3" Grid.Row="3" Margin="8,0" Foreground="{StaticResource FlowData}"/>
                    <TextBlock Text="{Binding EditingTextGroup.FlowDataIndex}" Foreground="White" Grid.Row="4" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EditingTextGroup.FlowDataOffset}" Foreground="White" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EditingTextGroup.FlowDataCompressedSize}" Foreground="White" Grid.Row="4" Grid.Column="2" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EditingTextGroup.FlowDataUncompressedSize}" Foreground="White" Grid.Row="4" Grid.Column="3" HorizontalAlignment="Center"/>
                </Grid>
                <Grid Grid.Column="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Width="2" Background="Black" CornerRadius="2"/>
                    <Border Width="2" Background="Black" Grid.Row="2" CornerRadius="2"/>
                </Grid>
                <Grid Grid.Column="4" HorizontalAlignment="Center" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Text Data" FontWeight="Bold" Margin="8,0" Foreground="{StaticResource TextDataBold}"/>
                    <TextBlock Text="Offset" HorizontalAlignment="Center" Grid.Column="1" Margin="8,0" Foreground="{StaticResource TextData}"/>
                    <TextBlock Text="Compressed Size" HorizontalAlignment="Center" Grid.Column="2" Margin="8,0" Foreground="{StaticResource TextData}"/>
                    <TextBlock Text="Uncompressed Size" HorizontalAlignment="Center" Grid.Column="3" Margin="8,0" Foreground="{StaticResource TextData}"/>
                    <TextBlock Text="{Binding SelectedTextGroup.TextDataIndex}" Grid.Row="1" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTextGroup.TextDataOffset}" Foreground="White" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTextGroup.TextDataCompressedSize}" Foreground="White" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTextGroup.TextDataUncompressedSize}" Foreground="White" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center"/>

                    <TextBlock Text="Text Data" FontWeight="Bold" Margin="8,0" Grid.Row="3" Foreground="{StaticResource TextDataBold}"/>
                    <TextBlock Text="Offset" HorizontalAlignment="Center" Grid.Row="3" Grid.Column="1" Margin="8,0" Foreground="{StaticResource TextData}"/>
                    <TextBlock Text="Compressed Size" HorizontalAlignment="Center" Grid.Row="3" Grid.Column="2" Margin="8,0" Foreground="{StaticResource TextData}"/>
                    <TextBlock Text="Uncompressed Size" HorizontalAlignment="Center" Grid.Row="3" Grid.Column="3" Margin="8,0" Foreground="{StaticResource TextData}"/>
                    <TextBlock Text="{Binding EditingTextGroup.TextDataIndex}" Grid.Row="4" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EditingTextGroup.TextDataOffset}" Foreground="White" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EditingTextGroup.TextDataCompressedSize}" Foreground="White" Grid.Row="4" Grid.Column="2" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EditingTextGroup.TextDataUncompressedSize}" Foreground="White" Grid.Row="4" Grid.Column="3" HorizontalAlignment="Center"/>
                </Grid>
                <Grid Grid.Column="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Width="2" Background="Black" CornerRadius="2"/>
                    <Border Width="2" Background="Black" Grid.Row="2" CornerRadius="2"/>
                </Grid>
                <Grid Grid.Column="6" Margin="4,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button IsEnabled="{Binding selected}" Background="Black" Content="  Edit Selected  " Click="Edit_Selected_Click" Margin="2" />
                    <Button IsEnabled="{Binding selected}" Background="Black" Grid.Row="2" Content="  Save Edited  " Click="Save_Edited_Click" Margin="2"/>
                </Grid>
            </Grid>
        </Grid>
        <Grid>


            <TabControl Background="Black" BorderThickness="0" Padding="0" Margin="2,5,2,1">
                <TabItem Template="{DynamicResource TabItem}" BorderBrush="{StaticResource DarkBlueBrush}"  Background="Black">
                    <TabItem.Header>
                        <TextBlock Text="Entry List" FontSize="14"/>
                    </TabItem.Header>
                    <Border BorderBrush="{StaticResource DarkBlueBrush}" BorderThickness="2">
                        <!--DIALOGUE/TEXT-->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <!-- Left pane -->
                                <ColumnDefinition Width="5" />
                                <!-- Splitter -->
                                <ColumnDefinition Width="*" />
                                <!-- Right pane -->
                            </Grid.ColumnDefinitions>
                            <TabControl Background="Black" BorderThickness="0" Padding="0" Margin="2,3,2,2">
                                <TabItem Template="{DynamicResource TabItem}" BorderBrush="{StaticResource DarkBlueBrush}" 
             Header="Dialogue Entries" Background="Black">
                                    <Border BorderBrush="{StaticResource DarkBlueBrush}" BorderThickness="2">
                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                                                <TextBlock Text="Nº" Foreground="White" HorizontalAlignment="Center" Margin="8,0,24,0"/>
                                                <TextBlock Text="Index" Foreground="White" HorizontalAlignment="Center" Margin="10,0"/>
                                                <TextBlock Text="Offset" Foreground="White" HorizontalAlignment="Center" Margin="22,0"/>
                                                <TextBlock Text="C. Size" Foreground="White" HorizontalAlignment="Center" Margin="12,0"/>
                                                <TextBlock Text="U. Size" Foreground="White" HorizontalAlignment="Center" Margin="13,0"/>
                                            </StackPanel>
                                            <Grid DockPanel.Dock="Bottom"> 
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Rectangle Fill="{StaticResource DarkBlueBrush}" Grid.ColumnSpan="3" Height="2"/>
                                                <TextBlock Margin="5,2" Text="Filter:" VerticalAlignment="Center" Grid.Column="0" Grid.Row="1"/>
                                                <TextBox Margin="1" BorderThickness="0" Text="{Binding FilterText,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Grid.Column="1" Grid.Row="1" TextWrapping="WrapWithOverflow"/>
                                                <Button Click="Search_Click" Margin="5,2" Content="Search" HorizontalAlignment="Right" Grid.Column="2" Grid.Row="1" Padding="5,0" VerticalContentAlignment="Center" ToolTipService.InitialShowDelay="0" >
                                                    <Button.ToolTip>
                                                        <ToolTip Background="Black">
                                                            <Label Content="WARNING: This will take a long time."/>
                                                        </ToolTip>
                                                    </Button.ToolTip>
                                                </Button>
                                            </Grid>
                                            <ListBox SizeChanged="SizeChange" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     Name="listBox" Background="Black" BorderThickness="0" ItemsSource="{Binding Dialogues}" SelectionChanged="Dialogues_SelectionChanged" MouseDoubleClick="Dialogues_MouseDoubleClick">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Grid.Column="4" MaxWidth="{Binding DataContext.EntryWidth, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Index}" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="26"/>
                                                            <UniformGrid Columns="4" Rows="2"  Grid.Column="1" HorizontalAlignment="Center" Margin="5,0" >
                                                                <TextBlock Text="{Binding FlowDataIndex}" Grid.Column="1" HorizontalAlignment="Center" Foreground="{StaticResource FlowData}"/>
                                                                <TextBlock Text="{Binding FlowDataOffset}" Grid.Column="2" HorizontalAlignment="Center" Foreground="{StaticResource FlowData}"/>
                                                                <TextBlock Text="{Binding FlowDataCompressedSize}" Grid.Column="3" HorizontalAlignment="Center" Foreground="{StaticResource FlowData}"/>
                                                                <TextBlock Text="{Binding FlowDataUncompressedSize}" Grid.Column="4" HorizontalAlignment="Center" Foreground="{StaticResource FlowData}"/>

                                                                <TextBlock Text="{Binding TextDataIndex}" Grid.Row="1" Grid.Column="1"  HorizontalAlignment="Center" Foreground="{StaticResource TextData}"/>
                                                                <TextBlock Text="{Binding TextDataOffset}" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" Foreground="{StaticResource TextData}"/>
                                                                <TextBlock Text="{Binding TextDataCompressedSize}" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" Foreground="{StaticResource TextData}"/>
                                                                <TextBlock Text="{Binding TextDataUncompressedSize}" Grid.Row="1" Grid.Column="4" HorizontalAlignment="Center" Foreground="{StaticResource TextData}"/>
                                                            </UniformGrid>
                                                            <TextBlock Text="{Binding PreviewLine}" Grid.RowSpan="2" Grid.Column="2" VerticalAlignment="Center" TextWrapping="WrapWithOverflow"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>
                                </TabItem>
                                <TabItem Template="{DynamicResource TabItem}" BorderBrush="{StaticResource DarkBlueBrush}" 
        Header="General Text Entries" Background="Black">
                                    <Border BorderBrush="{StaticResource DarkBlueBrush}" BorderThickness="2">
                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                                                <TextBlock Text="Nº" Foreground="White" HorizontalAlignment="Center" Margin="8,0,24,0"/>
                                                <TextBlock Text="Index" Foreground="White" HorizontalAlignment="Center" Margin="10,0"/>
                                                <TextBlock Text="Offset" Foreground="White" HorizontalAlignment="Center" Margin="22,0"/>
                                                <TextBlock Text="C. Size" Foreground="White" HorizontalAlignment="Center" Margin="12,0"/>
                                                <TextBlock Text="U. Size" Foreground="White" HorizontalAlignment="Center" Margin="13,0"/>
                                            </StackPanel>
                                            <ListBox Background="Black" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ItemsSource="{Binding MenuTexts}" SelectionChanged="MenuTexts_SelectionChanged" MouseDoubleClick="Dialogues_MouseDoubleClick">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Grid.Column="4" >
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Index}" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="26"/>
                                                            <UniformGrid Columns="4" Rows="1"  Grid.Column="1" HorizontalAlignment="Center" Margin="5,0" >
                                                                <TextBlock Text="{Binding TextDataIndex}" HorizontalAlignment="Center" Foreground="{StaticResource TextData}"/>
                                                                <TextBlock Text="{Binding TextDataOffset}" HorizontalAlignment="Center" Foreground="{StaticResource TextData}"/>
                                                                <TextBlock Text="{Binding TextDataCompressedSize}" HorizontalAlignment="Center" Foreground="{StaticResource TextData}"/>
                                                                <TextBlock Text="{Binding TextDataUncompressedSize}" HorizontalAlignment="Center" Foreground="{StaticResource TextData}"/>
                                                            </UniformGrid>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>
                                </TabItem>
                            </TabControl>

                            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="220,0,0,0" VerticalAlignment="Top">
                                <Button IsEnabled="{Binding selected}" VerticalAlignment="Top" Content="  Export...  " Margin="2" Click="ExportMenu_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="ExportMenu">
                                            <MenuItem Header="Sub-option 1"/>
                                            <MenuItem Header="Sub-option 2"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button IsEnabled="{Binding selected}" VerticalAlignment="Top" Content="  Import...  " Margin="2">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="ImportMenu">
                                            <MenuItem Header="Sub-option 1" />
                                            <MenuItem Header="Sub-option 2" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                            <Button IsEnabled="{Binding selected}" Content="  Preview  " Click="Preview_Click" VerticalAlignment="Top" Margin="2" HorizontalAlignment="Right"/>
                            <GridSplitter Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="{StaticResource DarkBlueBrush}"
                                          
                                  ShowsPreview="True"/>
                            <Line Y1="0" X2="1" X1="1" Y2="20" StrokeDashArray="0.25 2" StrokeDashCap="Round" IsHitTestVisible="False" Stroke=" Gray" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding PreviewIndex, StringFormat=Previewing {0}}" Margin="5"/>
                                <Border Name="BorderPreview" Grid.Row="1" BorderBrush="{StaticResource DarkBlueBrush}" BorderThickness="2" Margin="2">
                                    <ListBox Background="Black" BorderThickness="0"
                                             ItemsSource="{Binding TextLinesPreview}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="Preview_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <UC:DialoguePreview DisplayText="{Binding .}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                        </Grid>

                    </Border>
                </TabItem>
                <TabItem Template="{DynamicResource TabItem}" BorderBrush="{StaticResource DarkBlueBrush}" Background="Black" BorderThickness="0">
                    <TabItem.Header>
                        <TextBlock Text="Edit Entry" FontSize="14"/>
                    </TabItem.Header>
                    <panel:DialogueEntry/>
                </TabItem>
            </TabControl>
            <Grid x:Name="grid" VerticalAlignment="Top" Margin="150,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Langauage:" Margin="5,0" VerticalAlignment="Center"/>
                <ComboBox SelectedIndex="{Binding CurrentLanguage}" Grid.Column="1" VerticalContentAlignment="Center" ItemContainerStyle="{DynamicResource ComboBoxItemContainer}" ItemsSource="{Binding linkdata.Languages}" MinWidth="100"/>
                <TextBox Text="{Binding PName,UpdateSourceTrigger=PropertyChanged}" Grid.Column="2" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding PNameDef, FallbackValue=PName}" IsHitTestVisible="False" Visibility="{Binding NameValid}" Grid.Column="2" Margin="8,6" Foreground="Gray" />
                <ToggleButton Content="♂" Width="{Binding ActualHeight, ElementName=grid, Mode=OneWay}" IsChecked="{Binding Male}" Grid.Column="3" BorderBrush="{StaticResource DarkBlueBrush}" BorderThickness="1" Margin="2,0" FontSize="14"/>
                <ToggleButton Content="♀" Width="{Binding ActualHeight, ElementName=grid, Mode=OneWay}" IsChecked="{Binding Female}" Grid.Column="4" BorderBrush="{StaticResource DarkBlueBrush}" BorderThickness="1" Margin="2,0" FontSize="14"/>
                <StackPanel Background="Black" Orientation="Horizontal"  Grid.Column="5" Margin="0,4">
                    <TextBlock Text="Version:" Margin="4,0"/>
                    <TextBlock Text="{Binding linkdata.LINKDATAVersion}" Foreground="Gold" HorizontalAlignment="Right" Margin="4,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
