<Window x:Class="DQB2TextEditor.Windows.TextEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DQB2TextEditor.Windows"
        mc:Ignorable="d"
        Title="TextEditor" Height="450" Width="800" Background="Black" MinWidth="900">
    <DockPanel>
        <Border Background="{StaticResource DarkBlueBrush}" DockPanel.Dock="Bottom" Margin="2,1,2,2" CornerRadius="5">
            <Grid Margin="0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <UniformGrid Grid.Column="0" Rows="2" HorizontalAlignment="Left" Margin="8,0">
                    <TextBlock Text="{Binding Path=Selection, StringFormat=Selected {0}}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedTextGroup.Index}" Foreground="White" HorizontalAlignment="Center"/>
                </UniformGrid>
                <Border Grid.Column="1" Width="2" Background="Black" CornerRadius="2"/>
                <Grid Grid.Column="2" HorizontalAlignment="Center" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Flow Data" FontWeight="Bold" Margin="8,0"/>
                    <TextBlock Text="Offset" HorizontalAlignment="Center" Grid.Column="1" Margin="8,0"/>
                    <TextBlock Text="Compressed Size" HorizontalAlignment="Center" Grid.Column="2" Margin="8,0"/>
                    <TextBlock Text="Uncompressed Size" HorizontalAlignment="Center" Grid.Column="3" Margin="8,0"/>
                    <TextBlock Text="{Binding SelectedTextGroup.FlowDataIndex}" Foreground="White" Grid.Row="1" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTextGroup.FlowDataOffset}" Foreground="White" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTextGroup.FlowDataCompressedSize}" Foreground="White" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTextGroup.FlowDataUncompressedSize}" Foreground="White" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center"/>
                </Grid>
                <Border Grid.Column="3" Width="2" Background="Black" CornerRadius="2"/>
                <Grid Grid.Column="4" HorizontalAlignment="Center" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Text Data" FontWeight="Bold" Margin="8,0"/>
                    <TextBlock Text="Offset" HorizontalAlignment="Center" Grid.Column="1" Margin="8,0"/>
                    <TextBlock Text="Compressed Size" HorizontalAlignment="Center" Grid.Column="2" Margin="8,0"/>
                    <TextBlock Text="Uncompressed Size" HorizontalAlignment="Center" Grid.Column="3" Margin="8,0"/>
                    <TextBlock Text="{Binding SelectedTextGroup.TextDataIndex}" Grid.Row="1" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTextGroup.TextDataOffset}" Foreground="White" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTextGroup.TextDataCompressedSize}" Foreground="White" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTextGroup.TextDataUncompressedSize}" Foreground="White" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
        
        <TabControl Background="Black" BorderThickness="0" Padding="0" Margin="2,3,2,1">
            <TabItem Template="{DynamicResource TabItem}" BorderBrush="{StaticResource DarkBlueBrush}" Header="Entry List" Background="Black">
                <Border BorderBrush="{StaticResource DarkBlueBrush}" BorderThickness="2">
                    <!--DIALOGUE/TEXT-->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <!-- Left pane -->
                            <ColumnDefinition Width="5" />
                            <!-- Splitter -->
                            <ColumnDefinition Width="*" />
                            <!-- Right pane -->
                        </Grid.ColumnDefinitions>

                        <TabControl Background="Black" BorderThickness="0" Padding="0" Margin="2,3,2,2">
                            <TabItem Template="{DynamicResource TabItem}" BorderBrush="{StaticResource DarkBlueBrush}" 
             Header="Dialogue Entries" Background="Black">
                                <Border BorderBrush="{StaticResource DarkBlueBrush}" BorderThickness="2">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top"> 
                                            <TextBlock Text="Nº" Foreground="White" HorizontalAlignment="Center" Margin="8,0,24,0"/>
                                            <TextBlock Text="Index" Foreground="White" HorizontalAlignment="Center" Margin="10,0"/>
                                            <TextBlock Text="Offset" Foreground="White" HorizontalAlignment="Center" Margin="22,0"/>
                                            <TextBlock Text="C. Size" Foreground="White" HorizontalAlignment="Center" Margin="12,0"/>
                                            <TextBlock Text="U. Size" Foreground="White" HorizontalAlignment="Center" Margin="13,0"/>
                                        </StackPanel>
                                        <ListBox Background="Black"  BorderThickness="0" ItemsSource="{Binding Dialogues}" SelectionChanged="Dialogues_SelectionChanged" MouseDoubleClick="Dialogues_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Grid.Column="4" >
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Index}" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="26"/>
                                                    <UniformGrid Columns="4" Rows="2"  Grid.Column="1" HorizontalAlignment="Center" Margin="5,0">
                                                        <TextBlock Text="{Binding FlowDataIndex}" Foreground="White" Grid.Column="1" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FlowDataOffset}" Foreground="White" Grid.Column="2" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FlowDataCompressedSize}" Foreground="White" Grid.Column="3" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FlowDataUncompressedSize}" Foreground="White" Grid.Column="4" HorizontalAlignment="Center"/>

                                                        <TextBlock Text="{Binding TextDataIndex}" Grid.Row="1" Foreground="White" Grid.Column="1"  HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding TextDataOffset}" Foreground="White" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding TextDataCompressedSize}" Foreground="White" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding TextDataUncompressedSize}" Foreground="White" Grid.Row="1" Grid.Column="4" HorizontalAlignment="Center"/>
                                                    </UniformGrid>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    </DockPanel>
                                </Border>
                            </TabItem>
                            <TabItem Template="{DynamicResource TabItem}" BorderBrush="{StaticResource DarkBlueBrush}" 
        Header="General Text Entries" Background="Black">
                                <Border BorderBrush="{StaticResource DarkBlueBrush}" BorderThickness="2">

                                </Border>
                            </TabItem>
                        </TabControl>
                        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{StaticResource DarkBlueBrush}"
                      ShowsPreview="True"/>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Preview Text:" Margin="5"/>
                            <TextBlock Text="Bind selection!!" HorizontalAlignment="Right" Margin="5"/>
                            <Border Grid.Row="1" BorderBrush="{StaticResource DarkBlueBrush}" BorderThickness="2" Margin="2">
                                <ListBox Background="Black" BorderThickness="0" ItemsSource="{Binding TextLinesPreview}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Label Content="{Binding .}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Grid>
                    
                </Border>
            </TabItem>
            <TabItem  Template="{DynamicResource TabItem}" BorderBrush="{StaticResource DarkBlueBrush}" Header="Edit Entry" Background="Black" BorderThickness="0">
                <ScrollBar/>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
